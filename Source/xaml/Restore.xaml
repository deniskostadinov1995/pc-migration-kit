<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- ================================================================ 1. pick a backup -->
  <ScrollViewer x:Name="PickView" VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="36,6,36,36" MaxWidth="1000" HorizontalAlignment="Left">
      <TextBlock Text="Restore onto this PC" Style="{StaticResource T.H1}"/>
      <TextBlock Text="Run this on the new Windows, signed in as the account you'll use. It installs your programs again, brings back your files, settings, automations and media server, and remembers what is done - so it's safe to run again after a restart." Style="{StaticResource T.Muted}" Margin="0,6,0,0" MaxWidth="780" HorizontalAlignment="Left"/>
      <DockPanel Margin="0,24,0,12">
        <Button x:Name="BrowseBackup" DockPanel.Dock="Right" Style="{StaticResource Btn}" Content="Find a backup folder..."/>
        <TextBlock Text="Backups" Style="{StaticResource T.H2}" VerticalAlignment="Center"/>
      </DockPanel>
      <StackPanel x:Name="BackupList"/>
      <Border x:Name="Details" Style="{StaticResource Card}" Margin="0,8,0,0" Visibility="Collapsed">
        <StackPanel>
          <TextBlock x:Name="DetTitle" Text="" Style="{StaticResource T.H3}"/>
          <TextBlock x:Name="DetLine" Text="" Style="{StaticResource T.Muted}" Margin="0,4,0,0"/>
          <Border x:Name="DetWarn" CornerRadius="8" Padding="12,10" Margin="0,12,0,0" Background="{DynamicResource B.WarnSoft}" Visibility="Collapsed">
            <TextBlock x:Name="DetWarnText" Text="" Foreground="{DynamicResource B.Text}" TextWrapping="Wrap"/>
          </Border>
        </StackPanel>
      </Border>
      <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
        <Button x:Name="ToChoose" Style="{StaticResource Btn.Primary}" IsEnabled="False">
          <StackPanel Orientation="Horizontal"><TextBlock Text="Choose what to restore"/><TextBlock Text="&#xE72A;" FontFamily="{StaticResource IconFont}" Margin="10,0,0,0" VerticalAlignment="Center" FontSize="11"/></StackPanel>
        </Button>
        <TextBlock x:Name="ReadingLine" Text="" Style="{StaticResource T.Small}" VerticalAlignment="Center" Margin="14,0,0,0"/>
      </StackPanel>
    </StackPanel>
  </ScrollViewer>

  <!-- ================================================================ 2. choose -->
  <Grid x:Name="ChooseView" Visibility="Collapsed">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <StackPanel Margin="36,6,36,14">
      <TextBlock Text="Choose what to restore" Style="{StaticResource T.H1}"/>
      <TextBlock x:Name="ChooseLine" Text="" Style="{StaticResource T.Muted}" Margin="0,6,0,0"/>
    </StackPanel>
    <Grid Grid.Row="1" Margin="36,0,36,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="268"/>
        <ColumnDefinition Width="16"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <Border Style="{StaticResource Card}" Padding="8">
        <ListBox x:Name="CatList" ItemTemplate="{StaticResource CatTemplate}" ItemContainerStyle="{StaticResource CatItem}"/>
      </Border>
      <Border Grid.Column="2" Style="{StaticResource Card}" Padding="0">
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <DockPanel Margin="20,16,16,10">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
              <Button x:Name="SelAll" Style="{StaticResource Btn.Ghost}" Content="Tick all"/>
              <Button x:Name="SelNone" Style="{StaticResource Btn.Ghost}" Content="Untick all" Margin="4,0,0,0"/>
            </StackPanel>
            <StackPanel>
              <TextBlock x:Name="CatTitle" Text="" Style="{StaticResource T.H2}"/>
              <TextBlock x:Name="CatDesc" Text="" Style="{StaticResource T.Muted}" Margin="0,4,0,0"/>
            </StackPanel>
          </DockPanel>
          <TreeView x:Name="ItemTree" Grid.Row="1" Margin="10,0,8,10" ItemTemplate="{StaticResource ItemTemplate}"/>
        </Grid>
      </Border>
    </Grid>
    <Border Grid.Row="2" Background="{DynamicResource B.Surface}" BorderBrush="{DynamicResource B.Border}" BorderThickness="0,1,0,0" Margin="0,16,0,0" Padding="36,14">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
          <CheckBox x:Name="DryRun" Style="{StaticResource Switch}" VerticalAlignment="Center" Margin="0,0,20,0">
            <TextBlock Text="Practice run (change nothing)" Foreground="{DynamicResource B.TextMuted}"/>
          </CheckBox>
          <Button x:Name="BackToPick" Style="{StaticResource Btn}" Content="Back"/>
          <Button x:Name="StartRestore" Style="{StaticResource Btn.Primary}" Margin="10,0,0,0">
            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE896;" FontFamily="{StaticResource IconFont}" Margin="0,0,10,0" VerticalAlignment="Center"/><TextBlock Text="Start the restore"/></StackPanel>
          </Button>
        </StackPanel>
        <StackPanel VerticalAlignment="Center">
          <TextBlock x:Name="TotalLine" Text="" Style="{StaticResource T.H3}"/>
          <TextBlock x:Name="TotalSub" Text="" Style="{StaticResource T.Small}"/>
        </StackPanel>
      </DockPanel>
    </Border>
  </Grid>

  <!-- ================================================================ 3. run / done -->
  <Grid x:Name="RunView" Visibility="Collapsed" Margin="36,6,36,24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <StackPanel>
      <TextBlock x:Name="RunTitle" Text="Restoring" Style="{StaticResource T.H1}"/>
      <TextBlock x:Name="RunLine" Text="" Style="{StaticResource T.Muted}" Margin="0,6,0,0"/>
    </StackPanel>
    <Grid Grid.Row="1" Margin="0,18,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="320"/>
        <ColumnDefinition Width="16"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <Border Style="{StaticResource Card}" Padding="14,12">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel>
            <TextBlock Text="STEPS" Style="{StaticResource T.Eyebrow}" Margin="4,0,0,8"/>
            <StackPanel x:Name="StepRows"/>
          </StackPanel>
        </ScrollViewer>
      </Border>
      <Grid Grid.Column="2">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Border Style="{StaticResource Card}">
          <StackPanel>
            <DockPanel>
              <TextBlock x:Name="CurRight" DockPanel.Dock="Right" Text="" Style="{StaticResource T.Small}"/>
              <TextBlock x:Name="CurLeft" Text="Getting ready" Style="{StaticResource T.H3}" TextTrimming="CharacterEllipsis"/>
            </DockPanel>
            <ProgressBar x:Name="CurBar" Margin="0,10,0,0" Height="6" IsIndeterminate="True"/>
            <TextBlock x:Name="CurFile" Text="" Style="{StaticResource T.Small}" Margin="0,6,0,0"/>
          </StackPanel>
        </Border>
        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,12,0,0" Padding="6">
          <ListBox x:Name="LogList" ItemContainerStyle="{StaticResource PlainItem}" VirtualizingStackPanel.IsVirtualizing="True" ScrollViewer.CanContentScroll="True"/>
        </Border>
      </Grid>
    </Grid>
    <DockPanel Grid.Row="2" Margin="0,14,0,0">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
        <Button x:Name="OpenLog" Style="{StaticResource Btn.Ghost}" Content="Open log" Visibility="Collapsed"/>
        <Button x:Name="RunAgain" Style="{StaticResource Btn}" Content="Choose again" Margin="8,0,0,0" Visibility="Collapsed"/>
        <Button x:Name="GoVerify" Style="{StaticResource Btn.Primary}" Content="Verify everything is back" Margin="8,0,0,0" Visibility="Collapsed"/>
        <Button x:Name="RestartPc" Style="{StaticResource Btn.Primary}" Content="Restart the PC" Margin="8,0,0,0" Visibility="Collapsed"/>
        <Button x:Name="StopRun" Style="{StaticResource Btn.Danger}" Content="Stop" Margin="8,0,0,0"/>
      </StackPanel>
      <TextBlock x:Name="RunFoot" Text="Windows Update won't restart the PC while this runs. If the PC restarts anyway, the restore opens again after you sign in." Style="{StaticResource T.Small}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,16,0"/>
    </DockPanel>
  </Grid>
</Grid>
