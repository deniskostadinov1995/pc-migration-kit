<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Margin="36,6,36,24">
  <Grid.RowDefinitions>
    <RowDefinition Height="Auto"/>
    <RowDefinition Height="*"/>
    <RowDefinition Height="Auto"/>
  </Grid.RowDefinitions>
  <StackPanel>
    <TextBlock Text="Media server &amp; smart home" Style="{StaticResource T.H1}"/>
    <TextBlock Text="Each part is checked the way you'd use it - does the web page answer, are the certificates valid, is the VM up. A repair installs what is missing, puts its data back from the newest backup, registers it the way it ran before and starts it. Parts that work are left alone." Style="{StaticResource T.Muted}" Margin="0,6,0,0" MaxWidth="860" HorizontalAlignment="Left"/>
  </StackPanel>
  <Grid Grid.Row="1" Margin="0,18,0,0">
    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Border Style="{StaticResource Card}" Padding="0">
      <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <DockPanel Margin="20,14,16,8">
          <Button x:Name="CheckNow" DockPanel.Dock="Right" Style="{StaticResource Btn}" VerticalAlignment="Top">
            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE72C;" FontFamily="{StaticResource IconFont}" Margin="0,0,10,0" VerticalAlignment="Center"/><TextBlock Text="Check again"/></StackPanel>
          </Button>
          <StackPanel>
            <TextBlock x:Name="ResultTitle" Text="Checking" Style="{StaticResource T.H2}"/>
            <TextBlock x:Name="ResultLine" Text="" Style="{StaticResource T.Muted}" Margin="0,4,0,0"/>
          </StackPanel>
        </DockPanel>
        <ProgressBar x:Name="CheckBar" Grid.Row="0" VerticalAlignment="Bottom" Height="3" Margin="20,0,16,0" IsIndeterminate="True" Visibility="Collapsed"/>
        <TreeView x:Name="Parts" Grid.Row="1" Margin="10,4,8,10" ItemTemplate="{StaticResource ItemTemplate}"/>
      </Grid>
    </Border>
    <Border x:Name="LogCard" Grid.Row="1" Style="{StaticResource Card}" Margin="0,12,0,0" Padding="6" Height="240" Visibility="Collapsed">
      <ListBox x:Name="LogList" ItemContainerStyle="{StaticResource PlainItem}" VirtualizingStackPanel.IsVirtualizing="True" ScrollViewer.CanContentScroll="True"/>
    </Border>
  </Grid>
  <DockPanel Grid.Row="2" Margin="0,14,0,0">
    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
      <CheckBox x:Name="DryRun" Style="{StaticResource Switch}" VerticalAlignment="Center" Margin="0,0,20,0">
        <TextBlock Text="Practice run" Foreground="{DynamicResource B.TextMuted}"/>
      </CheckBox>
      <Button x:Name="Repair" Style="{StaticResource Btn.Primary}" IsEnabled="False">
        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE90F;" FontFamily="{StaticResource IconFont}" Margin="0,0,10,0" VerticalAlignment="Center"/><TextBlock x:Name="RepairText" Text="Set up the ticked parts"/></StackPanel>
      </Button>
    </StackPanel>
    <TextBlock x:Name="FootLine" Text="" Style="{StaticResource T.Small}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,16,0"/>
  </DockPanel>
</Grid>
