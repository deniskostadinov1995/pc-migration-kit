<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PC Migration Kit" Width="1240" Height="820" MinWidth="1000" MinHeight="660"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource B.Bg}"
        FontFamily="{DynamicResource UiFont}" FontSize="13" Foreground="{DynamicResource B.Text}"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="40" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
  </WindowChrome.WindowChrome>
  <Grid x:Name="RootGrid">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="232"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <!-- ============ left rail ============ -->
    <Border Grid.Column="0" Background="{DynamicResource B.Sidebar}" BorderBrush="{DynamicResource B.Border}" BorderThickness="0,0,1,0">
      <DockPanel Margin="14,14,14,14">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="4,2,0,22">
          <Border Width="34" Height="34" CornerRadius="9">
            <Border.Background>
              <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#5B8DEF" Offset="0"/>
                <GradientStop Color="#7B5BEF" Offset="1"/>
              </LinearGradientBrush>
            </Border.Background>
            <TextBlock Text="&#xE8AB;" FontFamily="{StaticResource IconFont}" FontSize="17" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
            <TextBlock Text="PC Migration Kit" FontWeight="SemiBold" FontSize="14" Foreground="{DynamicResource B.Text}"/>
            <TextBlock x:Name="VersionText" Text="version 2.0" FontSize="11" Foreground="{DynamicResource B.TextFaint}"/>
          </StackPanel>
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom">
          <Border x:Name="AdminChip" CornerRadius="8" Padding="10,8" Background="{DynamicResource B.Surface2}" Margin="0,0,0,8" Cursor="Hand" ToolTip="Some parts need administrator rights. Click to restart the program as administrator.">
            <StackPanel Orientation="Horizontal">
              <TextBlock x:Name="AdminIcon" Text="&#xE7EF;" Style="{StaticResource T.Icon}" FontSize="14" Foreground="{DynamicResource B.Warn}"/>
              <TextBlock x:Name="AdminText" Text="Not administrator" Margin="8,0,0,0" FontSize="12" Foreground="{DynamicResource B.TextMuted}" VerticalAlignment="Center"/>
            </StackPanel>
          </Border>
          <Button x:Name="ThemeButton" Style="{StaticResource Btn.Ghost}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" ToolTip="Switch between light and dark">
            <StackPanel Orientation="Horizontal">
              <TextBlock x:Name="ThemeIcon" Text="&#xE793;" Style="{StaticResource T.Icon}" FontSize="14" Foreground="{DynamicResource B.TextMuted}"/>
              <TextBlock x:Name="ThemeText" Text="Dark mode" Margin="10,0,0,0" FontSize="12" Foreground="{DynamicResource B.TextMuted}"/>
            </StackPanel>
          </Button>
        </StackPanel>

        <StackPanel x:Name="NavPanel">
          <TextBlock Text="WHAT TO DO" Style="{StaticResource T.Eyebrow}" Margin="12,0,0,8"/>
          <RadioButton x:Name="NavHome" Style="{StaticResource Nav}" GroupName="nav" Tag="home">
            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE80F;" Style="{StaticResource T.Icon}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Width="20"/><TextBlock Text="Home" Margin="12,0,0,0"/></StackPanel>
          </RadioButton>
          <RadioButton x:Name="NavBackup" Style="{StaticResource Nav}" GroupName="nav" Tag="backup">
            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE898;" Style="{StaticResource T.Icon}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Width="20"/><TextBlock Text="Scan &amp; back up" Margin="12,0,0,0"/></StackPanel>
          </RadioButton>
          <RadioButton x:Name="NavRestore" Style="{StaticResource Nav}" GroupName="nav" Tag="restore">
            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE896;" Style="{StaticResource T.Icon}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Width="20"/><TextBlock Text="Restore" Margin="12,0,0,0"/></StackPanel>
          </RadioButton>
          <RadioButton x:Name="NavVerify" Style="{StaticResource Nav}" GroupName="nav" Tag="verify">
            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE9D5;" Style="{StaticResource T.Icon}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Width="20"/><TextBlock Text="Verify &amp; fix" Margin="12,0,0,0"/></StackPanel>
          </RadioButton>
          <RadioButton x:Name="NavMedia" Style="{StaticResource Nav}" GroupName="nav" Tag="media">
            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8B2;" Style="{StaticResource T.Icon}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Width="20"/><TextBlock Text="Media server" Margin="12,0,0,0"/></StackPanel>
          </RadioButton>
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- ============ content ============ -->
    <Grid Grid.Column="1">
      <Grid.RowDefinitions>
        <RowDefinition Height="40"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>
      <!-- title bar -->
      <Grid Grid.Row="0">
        <TextBlock x:Name="TitleText" Text="" Margin="22,0,0,0" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource B.TextFaint}"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" WindowChrome.IsHitTestVisibleInChrome="True">
          <Button x:Name="MinButton" Style="{StaticResource Btn.Caption}" Content="&#xE921;" ToolTip="Minimize"/>
          <Button x:Name="MaxButton" Style="{StaticResource Btn.Caption}" Content="&#xE922;" ToolTip="Maximize"/>
          <Button x:Name="CloseButton" Style="{StaticResource Btn.Close}" Content="&#xE8BB;" ToolTip="Close"/>
        </StackPanel>
      </Grid>
      <ContentControl x:Name="PageHost" Grid.Row="1" Focusable="False"/>
    </Grid>

    <!-- dialogs appear over everything -->
    <Grid x:Name="Overlay" Grid.ColumnSpan="2" Visibility="Collapsed">
      <Rectangle Fill="#8C000000"/>
      <ContentControl x:Name="OverlayHost" HorizontalAlignment="Center" VerticalAlignment="Center" Focusable="False" Margin="40"/>
    </Grid>
  </Grid>
</Window>
